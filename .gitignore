# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
build/
dist/
*.egg-info/

# Test / coverage / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Runtime artifacts (should not be committed)
logs/*.log
logs/*.log.*
database/*.db
database/*.db-journal
backups/*
!backups/.gitkeep
reports/*.json
reports/*.csv
reports/*.html
reports/*.txt

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
